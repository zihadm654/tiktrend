{
  "name": "@tiktrend/db",
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./schema": {
      "default": "./src/schema/index.ts"
    },
    "./*": {
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "bun --env-file=../../apps/web/.env run src/seed.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@tiktrend/env": "workspace:*",
    "dotenv": "catalog:",
    "drizzle-orm": "^0.45.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tiktrend/config": "workspace:*",
    "drizzle-kit": "^0.31.11",
    "typescript": "^6.0.3"
  }
}
