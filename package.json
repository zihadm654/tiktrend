{
  "name": "tiktrend",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.4.2",
      "zod": "^4.6.5",
      "@types/node": "^26.6.3",
      "next": "^16.3.6",
      "@orpc/server": "^1.15.4",
      "@orpc/client": "^1.15.4",
      "@orpc/openapi": "^1.15.4",
      "@orpc/zod": "^1.15.4",
      "better-auth": "1.6.22",
      "vitest": "4.1.8",
      "@vitest/ui": "4.1.8",
      "@vitest/coverage-v8": "4.1.8",
      "jsdom": "^29.1.1"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:web": "turbo -F web dev",
    "db:push": "turbo -F @tiktrend/db db:push",
    "db:studio": "turbo -F @tiktrend/db db:studio",
    "db:generate": "turbo -F @tiktrend/db db:generate",
    "db:migrate": "turbo -F @tiktrend/db db:migrate",
    "test": "bun run --filter web test && bun run --filter @tiktrend/api test",
    "lint": "ultracite check",
    "format": "ultracite fix",
    "lint:doctor": "ultracite doctor",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "prepare": "husky"
  },
  "dependencies": {
    "@tiktrend/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@tiktrend/config": "workspace:*",
    "@types/node": "catalog:",
    "husky": "latest",
    "lint-staged": "latest",
    "turbo": "2.10.11",
    "typescript": "^6.0.3",
    "ultracite": "8.0.0"
  },
  "overrides": {
    "kysely": "0.28.17"
  },
  "packageManager": "bun@1.4.2"
}
